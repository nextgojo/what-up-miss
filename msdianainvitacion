
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>One American Invitation</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Georgia, "Times New Roman", serif;
      color: #fff;
      background:
        linear-gradient(rgba(5, 16, 36, 0.78), rgba(5, 16, 36, 0.91)),
        url(https://image.fnnews.com/resource/media/image/2026/04/16/202604160725418745_l.png2000&q=85")
        center/cover fixed;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 24px;
    }

    .invitation {
      width: 100%;
      max-width: 600px;
      text-align: center;
      padding: 38px 26px;
      background: rgba(7, 18, 39, 0.86);
      border: 2px solid #c9a44c;
      box-shadow: 0 0 35px rgba(0, 0, 0, 0.5);
      border-radius: 8px;
    }

    .eagle {
      font-size: 66px;
      margin-bottom: 8px;
      line-height: 1.2;
    }

    .flag {
      color: #d7b45a;
      letter-spacing: 7px;
      font-size: 13px;
      text-transform: uppercase;
    }

    h1 {
      font-size: clamp(30px, 7vw, 45px);
      margin: 16px 0;
      color: #f3d58b;
      line-height: 1.15;
    }

    .message {
      font-family: Arial, sans-serif;
      font-size: 16px;
      line-height: 1.8;
      color: #e7eaf0;
    }

    .divider {
      width: 90px;
      height: 2px;
      background: #c9a44c;
      margin: 24px auto;
    }

    .question {
      font-size: 23px;
      margin: 22px 0;
      color: #fff;
    }

    .buttons {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
      margin: 24px 0;
      min-height: 54px;
    }

    button {
      border: 0;
      border-radius: 5px;
      padding: 14px 26px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s, transform 0.2s;
    }

    #yesBtn {
      background: #c9a44c;
      color: #101827;
    }

    #yesBtn:hover {
      background: #efd58d;
      transform: translateY(-2px);
    }

    #noBtn {
      background: #f2f2f2;
      color: #192238;
      position: relative;
    }

    #details {
      display: none;
      margin-top: 28px;
      padding-top: 22px;
      border-top: 1px solid #c9a44c;
      animation: appear 0.5s ease;
    }

    label {
      display: block;
      margin: 16px 0 8px;
      font-family: Arial, sans-serif;
      color: #f3d58b;
    }

    input {
      width: 100%;
      max-width: 300px;
      padding: 12px;
      border-radius: 5px;
      border: 1px solid #c9a44c;
      background: #fff;
      color: #172033;
      font-size: 16px;
    }

    #confirmBtn {
      display: block;
      margin: 24px auto 0;
      background: #c9a44c;
      color: #101827;
    }

    #finalMessage {
      display: none;
      margin-top: 24px;
      color: #f3d58b;
      font-size: 27px;
      font-weight: bold;
      animation: appear 0.5s ease;
    }

    .footer {
      margin-top: 30px;
      font: 11px Arial, sans-serif;
      color: #bfc6d3;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    @keyframes appear {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 480px) {
      .invitation {
        padding: 30px 18px;
      }

      .question {
        font-size: 20px;
      }

      button {
        padding: 13px 22px;
      }
    }
  </style>
</head>

<body>
  <main class="invitation">
    <div class="eagle" aria-label="American eagle">🦅</div>
    <div class="flag">Liberty · Courage · Friendship</div>

    <h1>A Special Invitation</h1>

    <p class="message">
      i have a big deccionto make 
    .<br>
      should i vote for republicans or 
      democrats?
      i will decide afher eat tacos.
    </p>

    <div class="divider"></div>

    <p class="question">So, what do you say? you wanna go for tacos?</p>

    <div class="buttons" id="buttons">
      <button id="yesBtn" type="button">Yes, let's do it!</button>
      <button id="noBtn" type="button">No</button>
    </div>

    <section id="details">
      <h2 style="color:#f3d58b;">Excellent decision.</h2>
      <p class="message">Choose the date and time that work for you , by way your gonna pay .</p>

      <label for="date">Choose a date</label>
      <input type="date" id="date">

      <label for="time">Choose a time</label>
      <input type="time" id="time">

      <button id="confirmBtn" type="button">Confirm the plan</button>
    </section>

    <div id="finalMessage">Send me a screenshot.</div>

    <div class="footer">god bless america and our troops</div>
  </main>

  <script>
    const yesBtn = document.getElementById("yesBtn");
    const noBtn = document.getElementById("noBtn");
    const details = document.getElementById("details");
    const finalMessage = document.getElementById("finalMessage");
    const dateInput = document.getElementById("date");
    const timeInput = document.getElementById("time");

    // Prevent selecting a date in the past.
    const today = new Date();
    const localToday = new Date(
      today.getTime() - today.getTimezoneOffset() * 60000
    ).toISOString().split("T")[0];

    dateInput.min = localToday;

    yesBtn.addEventListener("click", () => {
      details.style.display = "block";
      yesBtn.textContent = "Great choice!";
      details.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });

    // The "No" button tries to escape when approached or clicked.
    function moveNoButton() {
      const maxX = Math.max(0, window.innerWidth - noBtn.offsetWidth - 20);
      const maxY = Math.max(0, window.innerHeight - noBtn.offsetHeight - 20);

      noBtn.style.position = "fixed";
      noBtn.style.zIndex = "10";
      noBtn.style.left = Math.max(10, Math.random() * maxX) + "px";
      noBtn.style.top = Math.max(10, Math.random() * maxY) + "px";
    }

    noBtn.addEventListener("mouseenter", moveNoButton);
    noBtn.addEventListener("touchstart", function(event) {
      event.preventDefault();
      moveNoButton();
    });
    noBtn.addEventListener("click", moveNoButton);

    document.getElementById("confirmBtn").addEventListener("click", () => {
      if (!dateInput.value || !timeInput.value) {
        alert("Please choose both a date and a time.");
        return;
      }

      details.style.display = "none";
      buttons.style.display = "none";
      finalMessage.style.display = "block";
      finalMessage.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  </script>
</body>
</html>

